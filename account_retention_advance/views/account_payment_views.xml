<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_retention_advance" model="ir.ui.view">
        <field name="name">account.payment.form.retention.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_advance_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        invisible="advance_invoice_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="advance_invoice_count"/></span>
                        <span class="o_stat_text">Recoveries</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='memo']" position="after">
                <field name="is_advance_payment"
                       invisible="partner_type != 'customer' or payment_type != 'inbound'"
                       readonly="state not in ('draft', 'in_process', 'paid')"/>
                <field name="advance_order_id"
                       invisible="not is_advance_payment"
                       options="{'no_create': True}"/>
                <field name="advance_residual"
                       invisible="not is_advance_payment or state == 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_list_retention_advance" model="ir.ui.view">
        <field name="name">account.payment.list.retention.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_company_currency_signed']" position="after">
                <field name="advance_order_id" optional="hide"/>
                <field name="advance_residual" optional="hide" sum="Advance Balance"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_retention_advance" model="ir.ui.view">
        <field name="name">account.payment.search.retention.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='outbound_filter']" position="after">
                <separator/>
                <filter string="Advances" name="advance_filter" domain="[('is_advance_payment', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_account_advance_payments" model="ir.actions.act_window">
        <field name="name">Advance Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_advance_payment', '=', True)]</field>
        <field name="context">{
            'default_payment_type': 'inbound',
            'default_partner_type': 'customer',
            'default_is_advance_payment': True,
            'display_account_trust': True,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register an advance received from a customer</p>
            <p>Advances are recovered on the progress invoices of the project.</p>
        </field>
    </record>
</odoo>
