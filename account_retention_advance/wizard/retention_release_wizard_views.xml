<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="retention_release_wizard_view_form" model="ir.ui.view">
        <field name="name">retention.release.wizard.form</field>
        <field name="model">retention.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Release Retention">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="order_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="invoice_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="retention_held"/>
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="date_maturity"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="ref" placeholder="e.g. Handover certificate 12/2026"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="1">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="invoice_id" readonly="1" force_save="1"/>
                        <field name="project_sale_order_id" optional="show"/>
                        <field name="invoice_date" optional="show"/>
                        <field name="retention_due_date" optional="show"/>
                        <field name="retention_amount" sum="Total"/>
                        <field name="retention_residual" sum="Total"/>
                        <field name="amount" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_release" string="Release" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_retention_release_wizard" model="ir.actions.act_window">
        <field name="name">Release Retention</field>
        <field name="res_model">retention.release.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_retention_release_wizard_partner" model="ir.actions.act_window">
        <field name="name">Release Retention</field>
        <field name="res_model">retention.release.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="context">{'default_partner_id': active_id}</field>
    </record>
</odoo>
